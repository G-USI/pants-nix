{
  description = "Pants build system on Nix — FHS-free, patchelf-native";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    # python3.9 was removed from newer nixpkgs after its EOL; the cp39-era
    # Pants releases (2.21–2.24) build against this hydra-cached branch.
    nixpkgs-py39.url = "github:NixOS/nixpkgs/nixos-24.11";
  };

  outputs =
    { self, nixpkgs, nixpkgs-py39 }:
    let
      systems = [ "x86_64-linux" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;

      # Per-version release data (url, hash, python tag, lockfile-exact
      # deps) generated by scripts/generate.py — see pants/versions.nix.
      versionData = import ./pants/versions.nix;

      latestVersion = nixpkgs.lib.last (
        nixpkgs.lib.naturalSort (nixpkgs.lib.attrNames versionData)
      );

      mkPants =
        pkgs: pkgs39: {
          version,
          extraPythons ? [ ],
        }:
        let
          info = versionData.${version};
          interpreter =
            if info.python == "python39" then pkgs39.python39
            else if info.python == "python311" then pkgs.python311
            else if info.python == "python314" then pkgs.python314
            else throw "pants-nix: unsupported interpreter ${info.python} for ${version}";
        in
        pkgs.callPackage ./pants {
          pantsVersion = version;
          pantsUrl = info.url;
          pantsHash = info.hash;
          inherit (info) deps;
          inherit interpreter extraPythons;
        };
    in
    {
      lib = {
        inherit mkPants latestVersion versionData;
        # Read a repo's pants.toml and build exactly the pinned version:
        #   pants-nix.lib.fromPantsToml pkgs pkgs39 ./pants.toml
        # Changing [GLOBAL].pants_version in the toml re-resolves the
        # package on the next eval; unknown versions fail loudly once
        # their data is regenerated into pants/versions.nix.
        fromPantsToml =
          pkgs: pkgs39: tomlPath:
          let
            pantsToml = builtins.fromTOML (builtins.readFile tomlPath);
            global = pantsToml.GLOBAL or pantsToml.global or null;
            version =
              if global == null then
                throw "pants-nix: no [GLOBAL] section in ${toString tomlPath}"
              else
                global.pants_version;
          in
          mkPants pkgs pkgs39 { inherit version; };
      };

      packages = forAllSystems (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          pkgs39 = nixpkgs-py39.legacyPackages.${system};
          mangle = nixpkgs.lib.replaceStrings [ "." ] [ "_" ];
        in
        nixpkgs.lib.mapAttrs' (
          version: _:
          nixpkgs.lib.nameValuePair "pants-${mangle version}" (
            mkPants pkgs pkgs39 { inherit version; }
          )
        ) versionData
        // {
          default = self.packages.${system}."pants-${mangle latestVersion}";
        }
      );

      apps = forAllSystems (
        system:
        rec {
          pants = {
            type = "app";
            program = nixpkgs.lib.getExe self.packages.${system}.default;
          };
          default = pants;
        }
      );

      devShells = forAllSystems (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          pkgs39 = nixpkgs-py39.legacyPackages.${system};
        in
        {
          # Latest Pants + python3.14 on PATH so the interpreter search
          # can satisfy CPython==3.14.* resolves in downstream repos, and
          # the Rust toolchain so sandboxed cargo invocations use Nix
          # binaries (generic-Linux rustup cargo cannot run on NixOS
          # without an FHS sandbox).
          default = pkgs.mkShell {
            packages = [
              (mkPants pkgs pkgs39 {
                version = latestVersion;
                extraPythons = [ pkgs.python314 ];
              })
              pkgs.cargo
              pkgs.rustc
            ];
          };
        }
      );

      checks = forAllSystems (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          pkgs39 = nixpkgs-py39.legacyPackages.${system};
        in
        {
          version-smoke = pkgs.runCommand "pants-version-smoke"
            {
              nativeBuildInputs = [ self.packages.${system}.default ];
              # pantsd's socket bootstrap does not survive the check
              # sandbox; the version goal does not need it. The sandbox
              # HOME (/homeless-shelter) is not writable — pants needs a
              # writable ~/.cache/pants for its LMDB store.
              PANTS_PANTSD = "false";
              HOME = "/build";
            }
            ''
              mkdir -p project && cd project
              printf '[GLOBAL]\npants_version = "${latestVersion}"\n' > pants.toml
              pants --version > version.out
              grep -qx ${latestVersion} version.out || {
                echo "unexpected version:"; cat version.out; exit 1;
              }
              cp version.out $out
            '';
          oldest-smoke = pkgs39.runCommand "pants-oldest-version-smoke"
            {
              nativeBuildInputs = [
                (mkPants pkgs pkgs39 { version = nixpkgs.lib.head (nixpkgs.lib.naturalSort (nixpkgs.lib.attrNames versionData)); })
              ];
              PANTS_PANTSD = "false";
              HOME = "/build";
            }
            ''
              mkdir -p project && cd project
              printf '[GLOBAL]\npants_version = "${nixpkgs.lib.head (nixpkgs.lib.naturalSort (nixpkgs.lib.attrNames versionData))}"\n' > pants.toml
              pants --version > version.out
              cp version.out $out
            '';
        }
      );
    };
}
